# ── Ports (host-side; container-internal ports are fixed) ───────────────────
QDRANT_PORT=6333
VLLM_PORT=8000
TEI_PORT=8001
TEI_RERANK_PORT=8025
ANYTHINGLLM_PORT=3001

# ── AnythingLLM core ──────────────────────────────────────────────────────────
STORAGE_DIR=/app/server/storage
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-random-hex-64-chars
# UI password AND API bearer token used by the ingest script
AUTH_TOKEN=change-me-strong-password
# AnythingLLM's EncryptionManager self-assigns these on first boot and
# persists them to /app/server/.env -- a path NOT covered by this project's
# volume mounts. Every --force-recreate would otherwise generate a fresh
# random key, which then fails to decrypt data already encrypted under the
# PREVIOUS container's key (crashes the process -- see HALLUCINATION_FIXES.md
# for the incident this caused). Leave blank on first boot (auto-generated
# and logged), then copy the generated values here so they stay stable across
# recreations: docker exec <container> grep 'SIG_KEY\|SIG_SALT' /app/server/.env
SIG_KEY=
SIG_SALT=

# ── vLLM model ────────────────────────────────────────────────────────────────
# HuggingFace repo ID — loaded directly (safetensors, no GGUF conversion needed)
# Production uses the pre-quantized FP8 MoE model (--profile prequant, not bnb):
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
VLLM_API_KEY=token-abc123
# Fraction of GPU memory vLLM reserves. Has NOT needed to change despite
# raising VLLM_MAX_LEN twice and adding a second TEI instance -- the KV cache
# pool size is independent of context length (see ARCHITECTURE.md §2); only
# raise this for genuine OOM, not to "make room" for a longer context.
VLLM_GPU_MEM=0.6
# The model's own native max_position_embeddings (checked directly in its HF
# config) -- not a rope-scaling extension. Changing this requires a full
# container recreate (~8-10 min: CUDA graph capture + FP8 MoE kernel JIT
# compile via DeepGEMM/nvcc, paid again every time since the compile cache
# isn't volume-mounted).
VLLM_MAX_LEN=262144
VLLM_GPU_DEVICE=1   # host GPU index vLLM is pinned to (see nvidia-smi)
# vLLM's uvicorn server defaults this to 5s -- too short if any request-time
# step (e.g. reranking) takes longer, causing intermittent "Connection error"
# on the next request over the same pooled connection. Not a GPU/memory
# setting, safe to raise freely.
VLLM_HTTP_TIMEOUT_KEEP_ALIVE=120
# Optional: absolute path to redirect the HF model cache to a bigger disk
# (defaults to ./cache/huggingface). Leave unset unless you hit disk space issues.
HF_CACHE_DIR=
# Optional: HF token for gated models
HF_TOKEN=

# ── Embedding model (TEI) ─────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3

# ── Reranking model (TEI-rerank) ──────────────────────────────────────────────
# A cross-encoder (not an embedding model) on the same GPU, used to rerank
# retrieval candidates -- see ARCHITECTURE.md §4. Multilingual/Polish-capable,
# unlike AnythingLLM's bundled CPU-only reranker (English-only, and slow
# enough to trigger the keep-alive issue above).
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Pre-rerank candidate pool size (read by patches/anythingllm/qdrant-index.js).
# Independent of the workspace's topN (post-rerank result count) -- a wider
# pool gives the cross-encoder more to work with to rescue chunks cosine
# similarity underrated.
CBDU_RERANK_POOL_SIZE=250

# ── AnythingLLM → vLLM ────────────────────────────────────────────────────────
LLM_PROVIDER=generic-openai
GENERIC_OPEN_AI_BASE_PATH=http://vllm:8000/v1
GENERIC_OPEN_AI_MODEL_PREF=local-model
GENERIC_OPEN_AI_API_KEY=token-abc123
GENERIC_OPEN_AI_MAX_TOKENS=8192
# Must match VLLM_MAX_LEN -- this drives AnythingLLM's own history/system/user
# token-budget split (promptWindowLimit(), 15%/15%/70%). Left stale at an old,
# smaller value would silently cap how much retrieved context AnythingLLM is
# willing to send, even though vLLM itself could handle more.
GENERIC_OPEN_AI_CONTEXT_WINDOW=262144

# ── AnythingLLM → TEI embeddings ─────────────────────────────────────────────
EMBEDDING_ENGINE=generic-openai
EMBEDDING_BASE_PATH=http://tei:80
EMBEDDING_MODEL_PREF=BAAI/bge-m3
EMBEDDING_API_KEY=no-key-required
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=1500

# ── Vector DB → Qdrant ────────────────────────────────────────────────────────
VECTOR_DB=qdrant
QDRANT_ENDPOINT=http://qdrant:6333

# ── Ingest script ─────────────────────────────────────────────────────────────
# ANYTHINGLLM_API_KEY is a developer API key — different from AUTH_TOKEN (UI
# password). Leave blank: ingest.py's ensure_api_key() auto-provisions one on
# first run using AUTH_TOKEN and writes it back here — no UI step needed.
ANYTHINGLLM_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
DATA_FILE=data/CBDU_ocr_gemini_pro_2.5.json
WORKSPACE_NAME=CBDU Historical Pamphlets
# 0.05, not 0 or 0.2. Confirmed via repeated identical queries that temp=0.2
# caused genuine semantic flips (safe decline vs. confident fabrication) on
# identical retrieved context -- proven NOT a retrieval issue (embeddings and
# full retrieval round-trips are bit-identical across repeated calls; only
# generation sampling varied). temp=0 (greedy) eliminated that failure mode;
# temp=0.05 was then found to modestly improve mean quality over temp=0 while
# staying far below where the temp=0.2 fabrication pattern reappeared.
WORKSPACE_TEMP=0.05
